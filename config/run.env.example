# Output directory
RUN_OUTPUT=/data/patent_run

# Stage 01: August 2026 source tables and patent metadata
REGPAT_RELEASE=/data/REGPAT_2026
# Supply PATSTAT_DB, OPS_CACHE_DB or FAMILY_BACKBONE
PATSTAT_DB=/data/patstat.sqlite
OPS_CACHE_DB=
# FAMILY_BACKBONE=/data/family_backbone.sqlite
APPLICATION_MASTER=/data/regpat2026-application-master.parquet
APPLICATION_MASTER_RELEASE=regpat2026-ops-20261022-v1
# Inclusive representative application filing years
START_YEAR=2000
END_YEAR=2024
# Optional reusable intake index and distinct durable backup
# METADATA_CACHE=/data/intake-cache/local-index.sqlite
# METADATA_CACHE_BACKUP=/data/intake-cache/patstat-metadata.sqlite

# Stage 03: TL2024 boundaries, Iceland TL2020 and August 2026 US lookup
BOUNDARIES=/data/oecd_regions.geojson
TL3_PROPERTY=tl3_id
REGION_PREFLIGHT=/data/region_mapping.json
# Measured service capacity
WORKERS=8
MAX_IN_FLIGHT=8
# Set the total network-attempt budget for the intended cohort
# For a 1,000-address sample, use REQUEST_BUDGET=20000 and MAX_ADDRESSES=1000
# For the full cohort, leave MAX_ADDRESSES unset
REQUEST_BUDGET=
TIMEOUT_SECONDS=31
MAX_ATTEMPTS=2
# MAX_ADDRESSES=1000
# Reuse an identified compatible forward cache; one active writer only
# GEOCODER_CACHE=/data/geocoding_cache
# GEOCODER_STOP_FILE=/data/patent_run/pause-geocoding

# Stages 04–05: polygon-first 1 km inference and a 50 km² postcode cap
# Private service identity and capacity record
GEOGRAPHIC_POLICY=/data/geographic_policy.json
GEOGRAPHIC_SERVICE=/data/nominatim_service.json
GHSL_SOURCE_MANIFEST=/data/ghsl_assets.json
# Separate working/durable directories; local SSD is optional
GEOGRAPHIC_BATCH_SIZE=250
GEOGRAPHIC_WORK_DIR=/data/patent_work/geography
GEOGRAPHIC_DURABLE_CACHE=/data/patent_run/geographic-cache
GEOGRAPHIC_STOP_FILE=/data/patent_run/pause-geography

# Stage 06: optional exact family fractions prepared from this same intake
# FAMILY_FRACTIONS=/data/patent_run/family-fractions

# Stage 07: evaluate a separate completed masked-query/area run
# MASKED_ALLOCATION_MANIFEST=/data/masking/05_grid/final_grid_manifest.json
# MASKED_QUERY_MANIFEST=/data/masking/03_geocoding/run_manifest.json
# MASKED_TRUTH=/data/masking/hidden_truth/truth.csv
# External comparisons of completed stage 06 outputs
# MORRISON_DESCRIPTORS=/data/morrison/all_disambiguated_patents_withLocal.txt
# MORRISON_INVENTORS=/data/morrison/LinkedInventorNameLocData.txt
# MORRISON_APPLICANTS=/data/morrison/LinkedAssigneeNameLocData.txt
# DE_RASSENFOSSE_INVENTORS=/data/de_rassenfosse/geoc_inv.txt
# DE_RASSENFOSSE_APPLICANTS=/data/de_rassenfosse/geoc_app.txt
# Optional verified crosswalk for changed application IDs
# DE_RASSENFOSSE_ID_MAP=/data/de_rassenfosse/application_ids.csv
# VALIDATION_START_YEAR=2000
# VALIDATION_END_YEAR=2024

# Stage 08: figures and tables
# FIGURES_CONFIG=/data/paper_outputs.json
